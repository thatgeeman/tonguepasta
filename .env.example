# Active provider: azure | openai | custom
PROVIDER=openai

# ── OpenAI ─────────────────────────────────────────────────────────────────
# PROVIDER=openai
OPENAI_API_KEY=sk-...

# ── Custom / Local (Ollama, LM Studio, etc.) ───────────────────────────────
# PROVIDER=custom
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# STT_MODEL=whisper
# CHAT_MODEL=llama3.2

# ── Azure OpenAI ────────────────────────────────────────────────────────────
# PROVIDER=azure
# AZURE_OPENAI_API_KEY=
# AZURE_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2025-01-01-preview
# AZURE_DEPLOYMENT=whisper              # STT model
# AZURE_CORRECT_DEPLOYMENT=gpt-4o-mini  # chat model

# ── Model overrides (optional - provider defaults are used if not set) ──────
# STT_MODEL=
# CHAT_MODEL=

# ── Audio ───────────────────────────────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_SILENCE_THRESHOLD=0.01
AUDIO_SILENCE_DURATION=1.5
