# Active provider: azure | openai | custom
PROVIDER=openai

# ── OpenAI ─────────────────────────────────────────────────────────────────
# PROVIDER=openai
OPENAI_API_KEY=sk-...

# ── Custom / Local (Ollama, LM Studio, etc.) ───────────────────────────────
# PROVIDER=custom
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# STT_MODEL=whisper
# CHAT_MODEL=llama3.2

# ── Azure OpenAI ────────────────────────────────────────────────────────────
# PROVIDER=azure
# AZURE_OPENAI_API_KEY=
# AZURE_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2025-01-01-preview
# AZURE_DEPLOYMENT=whisper              # STT model
# AZURE_CORRECT_DEPLOYMENT=gpt-4o-mini  # chat model

# ── Model overrides (optional - provider defaults are used if not set) ──────
# STT_MODEL=
# CHAT_MODEL=

# ── Audio ───────────────────────────────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_SILENCE_THRESHOLD=0.01
AUDIO_SILENCE_DURATION=1.5
# Minimum RMS level to attempt transcription (0.01 default; raise if Whisper
# hallucinates on silence, lower if your mic has low gain)
# STT_RMS_THRESHOLD=0.01
# Quiet recordings above STT_RMS_THRESHOLD are amplified toward this RMS before STT.
# 0.1 is a healthy speech level; lower it if audio sounds over-amplified/noisy.
STT_NORMALIZE_TARGET_RMS=0.1
# Maximum amplification multiplier. Peak headroom may reduce this further.
STT_MAX_GAIN=8.0

# ── Hotkey ───────────────────────────────────────────────────────────────────
# Key used for hold-to-record (Shift+this key toggles Lock n Load). Set from the
# tray menu's "Set Hotkey..." instead of editing this by hand.
# HOTKEY=ctrl_r
